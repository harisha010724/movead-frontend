# Copy to .env.local and adjust. Never commit .env.local.
# Only VITE_-prefixed variables reach the browser bundle — never put a secret here.

# Base URL of the MoveAd API. In development leave this as /v1's origin and let
# the Vite proxy handle it, so the browser stays same-origin and auth cookies work.
VITE_API_URL=

VITE_APP_ENV=local

# Where the dev proxy forwards /v1 requests. The backend's API service.
VITE_API_PROXY_TARGET=http://localhost:8080

# Both portal URLs. Locally they share one origin: advertisers at /, operations
# at /admin. Production still uses two hosts (app.movead.in and admin.movead.in).
VITE_ADVERTISER_URL=http://localhost:5173
VITE_ADMIN_URL=http://localhost:5173/admin

# Which portals serve canned responses instead of calling the API. Accepts
# true, false, or a comma-separated list of portals — both bundles read this
# same file, so naming the portal is what lets them differ. Ignored in
# production. `advertiser` while campaigns and billing are still unbuilt.
VITE_USE_MOCK_API=advertiser

# Set false to have the mock skip the admin second factor, matching
# ADMIN_MFA_REQUIRED in movead-backend/.env. Only the mock reads this — against
# the real API the server decides and the login page follows.
VITE_ADMIN_MFA_REQUIRED=true

# Optional
VITE_SENTRY_DSN=

# Browser Maps key (restricted by HTTP referrer). Enable on this key:
#   Maps JavaScript API  — render the map and draw zone polygons
#   Places API           — search / autocomplete (returns lat,lng)
# Geocoding API is optional; Places already returns coordinates.
# Do not enable Directions or Distance Matrix for this form.
VITE_GOOGLE_MAPS_API_KEY=
